{
  "name": "extendium",
  "version": "2.0.4",
  "description": "A plugin for Millennium that adds chrome extensions support to the client",
  "license": "MIT",
  "author": "BossSloth",
  "type": "module",
  "main": "./frontend/index.tsx",
  "scripts": {
    "dev": "millennium-ttc --build dev --watch",
    "sass": "sass ./public/extendium.scss:./public/extendium.css --style compressed --embed-sources --embed-source-map",
    "watch": "nodemon --watch public/extendium.scss --exec \"npm run sass && npm run dev\"",
    "build": "npm run sass && millennium-ttc --build prod",
    "lint": "eslint",
    "check": "bun check -p frontend && bun check -p webkit",
    "gen:compatibility": "bun run ./helpers/generate-compatibility-map.ts \"./Extendium 2.0 extension compatibility list - Compatibility list.csv\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@steambrew/client": "^5.8.5",
    "@steambrew/ttc": "~3.3.7",
    "@steambrew/webkit": "5.8.4",
    "react-icons": "^5.7.0",
    "sass-embedded": "^1.105.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.28.0",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "^1.4.3",
    "@types/chrome": "^0.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/webpack": "^5.28.5",
    "devtools-protocol": "^0.0.1718299",
    "eslint": "^10.12.0",
    "eslint-plugin-perfectionist": "^5.12.1",
    "globals": "^17.13.0",
    "knip": "^6.41.0",
    "nodemon": "^3.1.14",
    "semantic-release": "^25.0.9",
    "steam-types": "^2.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
