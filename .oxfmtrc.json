{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "tabWidth": 2,
  "printWidth": 120,
  "singleQuote": true,
  "trailingComma": "all",
  "bracketSameLine": false,
  "semi": true,
  "arrowParens": "always",
  "bracketSpacing": true,
  "experimentalOperatorPosition": "start",
  "sortPackageJson": true,
  "ignorePatterns": ["CHANGELOG.md", "*-header.html", "manifest.json"]
}
